# Single source of configuration for build + deployment.
# Copy to .env and adjust. Only VITE_* values are baked into the static bundle.

# Backend (publishable keys only — safe to ship in a static build)
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_xxx"
VITE_SUPABASE_PROJECT_ID="your-project"

# --- deployment (read by deploy.sh) ---
# Where the built files are served from
SITE_NAME="gramory"
WEB_ROOT="/var/www/gramory"
# Clearnet / LAN port (http://localhost and http://<lan-ip>)
HTTP_PORT="80"
# Loopback port that the Tor hidden service points at
TOR_PORT="8080"
# Tor hidden service directory
HS_DIR="/var/lib/tor/gramory"
