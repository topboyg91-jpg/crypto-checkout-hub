# Generated by deploy.sh — placeholders are substituted at deploy time.
# Do not edit /etc/nginx/sites-available/<site> by hand; edit this template.

# --- clearnet / LAN -------------------------------------------------------
server {
  listen __HTTP_PORT__ default_server;
  listen [::]:__HTTP_PORT__ default_server;
  server_name _;
  root __WEB_ROOT__;
  index index.html;

  gzip on;
  gzip_comp_level 6;
  gzip_min_length 512;
  gzip_types text/plain text/css application/javascript application/json image/svg+xml application/xml application/wasm;

  add_header Referrer-Policy "no-referrer" always;
  add_header X-Content-Type-Options "nosniff" always;
  add_header X-Frame-Options "DENY" always;

  location /assets/ { expires 1y; add_header Cache-Control "public, immutable"; }
  location /fonts/  { expires 1y; add_header Cache-Control "public, immutable"; }

  # Prerendered HTML first, then the SPA fallback so routes created after the
  # last build (new products) still resolve client-side.
  location / { try_files $uri $uri/index.html $uri.html /index.html; }
}

# --- Tor hidden service backend (loopback only) ---------------------------
server {
  listen 127.0.0.1:__TOR_PORT__;
  server_name _;
  root __WEB_ROOT__;
  index index.html;

  # Tor is slow: compress hard, cache hashed assets forever.
  gzip on;
  gzip_comp_level 9;
  gzip_min_length 256;
  gzip_types text/plain text/css application/javascript application/json image/svg+xml application/xml application/wasm;

  # Keep the .onion out of logs and off third-party origins.
  access_log off;
  server_tokens off;
  add_header Referrer-Policy "no-referrer" always;
  add_header X-Content-Type-Options "nosniff" always;
  add_header X-Frame-Options "DENY" always;
  add_header Onion-Location "" always;

  location /assets/ { expires 1y; add_header Cache-Control "public, immutable"; }
  location /fonts/  { expires 1y; add_header Cache-Control "public, immutable"; }

  location / { try_files $uri $uri/index.html $uri.html /index.html; }
}
